# Copy to .env for local development:
#   cp .env.example .env
#
# Local backend:
VITE_API_BASE_URL=http://localhost:8080/api
#
# In production (Vercel dashboard > Settings > Environment Variables),
# set this to your deployed backend, including the /api suffix:
#   VITE_API_BASE_URL=https://your-backend.up.railway.app/api
#
# Note: Vite only exposes variables prefixed with VITE_ to the browser,
# and they are baked in at build time - changing this requires a redeploy.
